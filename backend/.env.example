# 서버 포트
PORT=5000

# SMTP (Gmail 앱 비밀번호 예시). 587이면 STARTTLS, 465면 암시적 TLS로 자동 처리됨.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# 상태 변경 알림을 받을 수신자 이메일 (문의 폼도 이 주소로 옴)
ALERT_EMAIL_TO=you@example.com

# Postgres (조회수 집계 + 카카오 로그인/구독 저장). 없으면 두 기능 다 조용히 비활성화됨.
DATABASE_URL=postgres://user:password@host:5432/dbname

# 카카오 로그인 (Kakao Developers 앱의 REST API 키 / Client Secret / 등록한 Redirect URI)
# 셋 다 없으면 로그인 버튼이 자동으로 "준비 중" 상태로 비활성화됨.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.issmuok.site/auth/kakao/callback

# 로그인 세션 쿠키 도메인. 프론트/백엔드가 같은 상위 도메인의 서브도메인일 때만
# 설정 (예: issmuok.site + api.issmuok.site). 로컬 개발에서는 비워둘 것.
COOKIE_DOMAIN=.issmuok.site

# 카카오 로그인 완료 후 돌아갈 프론트엔드 주소
FRONTEND_URL=https://issmuok.site
