# 서버 포트
PORT=5000

# Resend(https://resend.com) API 키. Render가 아웃바운드 SMTP 포트(25/465/587)를
# 전부 막고 있어서(dial tcp ... i/o timeout으로 확인됨) 이메일은 SMTP 대신
# HTTPS API로 보낸다. 도메인 인증 전이면 RESEND_FROM 없이 기본값
# (onboarding@resend.dev)을 그대로 쓰면 됨.
RESEND_API_KEY=
RESEND_FROM=

# 상태 변경 알림을 받을 수신자 이메일 (문의 폼도 이 주소로 옴)
ALERT_EMAIL_TO=you@example.com

# Postgres (조회수 집계용). 없으면 조용히 비활성화되고 조회수만 안 뜸.
DATABASE_URL=postgres://user:password@host:5432/dbname

# 사이트별 디스코드 알림 채널의 Incoming Webhook URL. 채널마다 따로 만들어서
# 학생들이 관심 없는 사이트 채널은 뮤트할 수 있게 한다. 없는 사이트는 그냥
# 그 사이트만 알림 발송이 조용히 스킵됨(전체가 막히지 않음).
DISCORD_WEBHOOK_HOME=
DISCORD_WEBHOOK_ECAMPUS=
DISCORD_WEBHOOK_SAMMUL=
DISCORD_WEBHOOK_CLOUD=
DISCORD_WEBHOOK_DORM_SEOUL=
DISCORD_WEBHOOK_SUGANG=
