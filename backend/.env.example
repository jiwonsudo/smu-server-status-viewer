# 서버 포트
PORT=5000

# Resend(https://resend.com) API 키. Render가 아웃바운드 SMTP 포트(25/465/587)를
# 전부 막고 있어서(dial tcp ... i/o timeout으로 확인됨) 이메일은 SMTP 대신
# HTTPS API로 보낸다. 도메인 인증 전이면 RESEND_FROM 없이 기본값
# (onboarding@resend.dev)을 그대로 쓰면 됨.
RESEND_API_KEY=
RESEND_FROM=

# 상태 전환 알림을 받을 수신자 이메일 (문의 폼도 이 주소로 옴).
# 상태 전환 감지·알림은 이제 상시 가동되는 이 서버(internal/statemonitor)가
# statuscache 15초 갱신에 붙어서 직접 한다 — 예전 GitHub Actions(cmd/checkstatus)
# 방식은 제거됨. 따라서 아래 RESEND_*/ALERT_EMAIL_TO/DISCORD_WEBHOOK_* 는
# GitHub Actions Secrets가 아니라 Render 환경변수에 넣어야 알림이 나간다.
ALERT_EMAIL_TO=you@example.com

# Postgres. 없으면 조용히 비활성화됨:
#  - 조회수(site_clicks)가 안 뜸
#  - 상태 기준선(service_status)을 메모리로만 유지 → 서버 재시작 시 초기화되어
#    재시작 직후 첫 전환 1회는 "최초 기록"으로 간주돼 알림이 생략됨
DATABASE_URL=postgres://user:password@host:5432/dbname

# 사이트별 디스코드 알림 채널의 Incoming Webhook URL. 채널마다 따로 만들어서
# 학생들이 관심 없는 사이트 채널은 뮤트할 수 있게 한다. 없는 사이트는 그냥
# 그 사이트만 알림 발송이 조용히 스킵됨(전체가 막히지 않음).
DISCORD_WEBHOOK_HOME=
DISCORD_WEBHOOK_ECAMPUS=
DISCORD_WEBHOOK_SAMMUL=
DISCORD_WEBHOOK_CLOUD=
DISCORD_WEBHOOK_DORM_SEOUL=
DISCORD_WEBHOOK_SUGANG=

# 장애 이력 AI 분석 (internal/incidents). 키 하나로 임베딩 + 판정 둘 다 커버.
# 없어도 서비스는 정상 동작하고 장애도 계속 기록됨 — 임베딩/판정만 생략된다.
#  - 판정: 확정된 장애를 "일시적/지속적/판단보류"로 (gpt-4o-mini, 장애당 1회 ~$0.0005)
#  - 임베딩: incident 요약문을 저장 (text-embedding-3-small). 지금은 저장만 하고
#    검색은 SQL 집계로 함 — pgvector 승격 대비.
OPENAI_API_KEY=

# (선택, GitHub Actions Secret) 2차 안전망 워크플로(.github/workflows/monitor.yml)가
# /healthz 무응답 시 여기로 알림을 보낸다. 미설정이면 워크플로 실패로만 알림
# (GitHub이 저장소 소유자에게 메일 발송).
# DISCORD_WEBHOOK_OPS=
