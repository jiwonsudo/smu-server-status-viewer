# 서버 포트
PORT=5000

# Resend(https://resend.com) API 키. 이메일은 SMTP 대신 HTTPS API로 보낸다.
# 도메인 인증 전이면 RESEND_FROM 없이 기본값(onboarding@resend.dev)을 쓴다.
RESEND_API_KEY=
RESEND_FROM=

# 상태 전환 알림 + 문의 폼 수신자 이메일.
ALERT_EMAIL_TO=you@example.com

# Postgres. 없으면 조용히 비활성화됨: 조회수 미표시, 상태 기준선을
# 메모리로만 유지(서버 재시작 시 초기화).
DATABASE_URL=postgres://user:password@host:5432/dbname

# 사이트별 디스코드 알림 채널의 Incoming Webhook URL.
# 없는 사이트는 그 사이트만 알림 발송이 조용히 스킵된다.
DISCORD_WEBHOOK_HOME=
DISCORD_WEBHOOK_ECAMPUS=
DISCORD_WEBHOOK_SAMMUL=
DISCORD_WEBHOOK_CLOUD=
DISCORD_WEBHOOK_DORM_SEOUL=
DISCORD_WEBHOOK_SUGANG=

# 장애 이력 AI 분석용 OpenAI 키. 임베딩 + 판정 둘 다 커버. 없어도 서비스는
# 정상 동작하고 장애도 계속 기록됨 — 임베딩/판정만 생략된다.
OPENAI_API_KEY=

# (선택) 관리자 토큰. 설정하면 POST /api/incidents/{id}/reanalyze 로 특정
# incident의 AI 분석을 다시 돌릴 수 있다(X-Admin-Token 헤더). 미설정이면
# 그 라우트는 404로 막힘.
ADMIN_TOKEN=

# (선택, GitHub Actions Secret) 2차 안전망 워크플로가 /healthz 무응답 시
# 여기로 알림을 보낸다.
# DISCORD_WEBHOOK_OPS=
