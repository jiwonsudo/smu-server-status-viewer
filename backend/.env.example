# 서버 포트
PORT=5000

# SMTP (Gmail 앱 비밀번호 예시). 587이면 STARTTLS, 465면 암시적 TLS로 자동 처리됨.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# 상태 변경 알림을 받을 수신자 이메일
ALERT_EMAIL_TO=you@example.com

# 카카오톡 채널 메시지 API (아직 미연동 — 있으면 kakaoNotifier가 발송을 시도함)
KAKAO_ADMIN_KEY=
